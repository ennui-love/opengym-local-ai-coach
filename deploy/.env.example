# ── openGym 自部署配置模板 ──
# 用法：cp .env.example .env，然后按下面注释改 RP_ID / ORIGIN。
#
# 两个必须与「实际访问地址」严格一致的字段：
#   RP_ID  —— 只填主机名，不带协议
#   ORIGIN —— 完整地址，带 https://
# 二者必须匹配，否则 passkey 注册/登录会失败。

# ── 访问地址 ──
# 本方案用 Tailscale Serve 提供固定的私有 HTTPS 域名（仅你自己的 tailnet 内可访问）。
# 用 `tailscale serve status` 查看真实地址后替换下面两行。
RP_ID=<your-device>.<your-tailnet>.ts.net
ORIGIN=https://<your-device>.<your-tailnet>.ts.net
# 换机器 / 改设备名后地址会变，需同步改这两行并重启容器。
# 注意：地址一变，已注册的 passkey 全部失效（WebAuthn 把凭证绑定到域名），需重新注册。
#
# 阶段 1 本机测试可用下面这组（切域名后旧 passkey 会失效）：
#   RP_ID=localhost
#   ORIGIN=http://localhost:8080

# ── 基础 ──
WEB_PORT=8080
RP_NAME=openGym

# 首个注册的账号自动成为管理员（这样才能在后台开启 AI Coach）。
FIRST_USER_ADMIN=1

# 关闭游客模式：AI Coach 需要登录的 profile，不允许「无账号」进入。
ALLOW_GUEST=0

# ── AI Coach ──
# 本地小模型跑在 CPU 上很慢：首请求（规则缓存预热前）可能要十几分钟，这里给足 25 分钟。
# 如果之后还超时，再酌情调大（单位毫秒，永不低于 60000）。
COACH_JOB_TIMEOUT_MS=1500000
# 想彻底关掉 Coach，取消下面这行的注释：
# COACH_DISABLED=1

# ── 反向代理 ──
# 仅当 Cloudflare 确实在前面时才填 1，让审计日志记录真实访客 IP。
# 不要写 `$http_cf_connecting_ip`：compose 会把它当变量插值并产生 warning。
# 走 Tailscale 时保持留空。
CF_CONNECTING_IP=
